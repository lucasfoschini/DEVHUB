# Copy to .env. Development values only.
DATABASE_URL=postgresql://devhub:devhub@127.0.0.1:5433/devhub
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The browser reaches the API through the web origin (Vite proxies /api), so auth cookies stay first-party.
WEB_ORIGIN=http://localhost:5173
PORT=3000
# Development only: lets HTTP monitors check localhost and private networks. Never in production.
MONITOR_ALLOW_PRIVATE=false
# GitHub OAuth App (optional). Callback URL: http://localhost:5173/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Encrypts provider tokens at rest. 32 random bytes, base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
