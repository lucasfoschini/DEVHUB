{
  "name": "@devhub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsc -p tsconfig.build.json && node scripts/dev.mjs",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file=.env --enable-source-maps dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:int": "pnpm build && node --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.28",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@devhub/typescript-config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "22.20.7",
    "prisma": "7.10.1",
    "typescript": "6.0.3"
  }
}
