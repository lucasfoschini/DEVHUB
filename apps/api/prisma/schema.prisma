generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Explicit: Prisma otherwise infers it from tsconfig, which allows .ts imports for tests.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---- Better Auth (ADR 0003). Field names follow its core schema. ----

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---- DevHub ----

enum Role {
  owner
}

model Workspace {
  id                     String          @id @default(uuid(7))
  name                   String
  /// Set only for a user's personal workspace; unique so creating it is idempotent.
  personalFor            String?         @unique
  /// Notification kinds this workspace does not want (Settings). Checked when emitting.
  mutedNotificationKinds String[]        @default([])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  memberships            Membership[]
  auditLogs              AuditLog[]
  projects               Project[]
  monitors               Monitor[]
  incidents              Incident[]
  integrations           Integration[]
  repositories           Repository[]
  notifications          Notification[]
  secrets                Secret[]
  servers                Server[]
  notes                  Note[]
  automations            Automation[]
  prompts                Prompt[]
  devices                Device[]
  devicePairings         DevicePairing[]

  @@map("workspace")
}

model Membership {
  id          String    @id @default(uuid(7))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("membership")
}

/// Append-only. No update or delete path exists in code.
model AuditLog {
  id          String     @id @default(uuid(7))
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  /// Kept as a plain id so the record survives user deletion.
  actorId     String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

/// MASTER_PLAN §7.2 states. Archiving is a status, not a delete.
enum ProjectStatus {
  planning
  development
  testing
  production
  maintenance
  archived
}

model Project {
  id           String              @id @default(uuid(7))
  workspaceId  String
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String              @default("")
  status       ProjectStatus       @default(planning)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  monitors     Monitor[]
  repositories ProjectRepository[]
  secrets      Secret[]
  servers      Server[]
  notes        Note[]
  prompts      Prompt[]

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
  @@map("project")
}

enum MonitorState {
  unknown
  up
  down
}

/// HTTP health check (MASTER_PLAN §7.6). Targets pass the SSRF guard on every request.
model Monitor {
  id                  String         @id @default(uuid(7))
  workspaceId         String
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name                String
  url                 String
  intervalSeconds     Int            @default(300)
  timeoutMs           Int            @default(5000)
  enabled             Boolean        @default(true)
  state               MonitorState   @default(unknown)
  consecutiveFailures Int            @default(0)
  lastCheckedAt       DateTime?
  /// Due time; the scheduler claims a monitor by moving this forward atomically.
  nextCheckAt         DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  checks              MonitorCheck[]
  incidents           Incident[]

  @@unique([workspaceId, name])
  @@index([enabled, nextCheckAt])
  @@index([projectId])
  @@map("monitor")
}

model MonitorCheck {
  id         String   @id @default(uuid(7))
  monitorId  String
  monitor    Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  checkedAt  DateTime @default(now())
  ok         Boolean
  statusCode Int?
  latencyMs  Int?
  /// Short machine-readable reason when not ok (timeout, blocked_address, dns, http_status…).
  error      String?

  @@index([monitorId, checkedAt])
  @@index([checkedAt])
  @@map("monitor_check")
}

model Incident {
  id          String    @id @default(uuid(7))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monitorId   String
  monitor     Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  cause       String
  openedAt    DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([workspaceId, openedAt])
  @@index([monitorId, resolvedAt])
  @@map("incident")
}

enum IntegrationStatus {
  connected
  /// The provider rejected the stored token (revoked or expired): the user must reconnect.
  needs_reconnect
}

/// A provider account connected to a workspace (THREAT_MODEL.md B4). One per provider.
model Integration {
  id             String            @id @default(uuid(7))
  workspaceId    String
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider       String
  externalId     String
  externalLogin  String
  /// Scopes the provider actually granted, as reported by it.
  scopes         String[]
  /// AES-256-GCM, format "v1:iv:tag:ciphertext" (base64). Decrypted only inside the API.
  encryptedToken String
  status         IntegrationStatus @default(connected)
  connectedById  String
  lastSyncAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([workspaceId, provider])
  @@map("integration")
}

/// A provider repository imported into a workspace. Metadata is a snapshot taken from the
/// provider on import or sync, never from client input.
model Repository {
  id            String              @id @default(uuid(7))
  workspaceId   String
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider      String
  externalId    String
  fullName      String
  description   String              @default("")
  private       Boolean
  archived      Boolean             @default(false)
  defaultBranch String
  htmlUrl       String
  language      String?
  pushedAt      DateTime?
  importedById  String
  lastSyncAt    DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  projects      ProjectRepository[]

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, fullName])
  @@map("repository")
}

model ProjectRepository {
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([projectId, repositoryId])
  @@index([repositoryId])
  @@map("project_repository")
}

enum NotificationSeverity {
  info
  success
  warning
  critical
}

/// In-app notification (MASTER_PLAN §34). Emitted only on state transitions (incident opened or
/// resolved, integration needs reconnect), so a flapping source cannot flood the list.
model Notification {
  id          String               @id @default(uuid(7))
  workspaceId String
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Event type: monitor.down, monitor.recovered, integration.needs_reconnect.
  kind        String
  severity    NotificationSeverity
  title       String
  body        String               @default("")
  /// In-app path to the source, never an external URL.
  href        String?
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, readAt])
  @@map("notification")
}

/// Secrets Vault: one encrypted value per project, environment and name. The value never
/// appears in lists, logs or audit metadata; reading it is an explicit, audited action.
model Secret {
  id             String    @id @default(uuid(7))
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Environment variable style: [A-Z_][A-Z0-9_]*.
  name           String
  /// development | staging | production
  environment    String
  /// AES-256-GCM, same format as Integration.encryptedToken.
  encryptedValue String
  description    String    @default("")
  createdById    String
  lastRevealedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([projectId, environment, name])
  @@index([workspaceId])
  @@map("secret")
}

/// Infrastructure inventory entered by the user. No metrics are attached until an agent or
/// provider integration reports them (Phase 4/5).
model Server {
  id          String    @id @default(uuid(7))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String
  host        String
  /// Free text: Hetzner, AWS, VPS, home lab…
  provider    String    @default("")
  environment String
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([projectId])
  @@map("server")
}

/// Knowledge Base note in Markdown, optionally tied to a project.
model Note {
  id          String    @id @default(uuid(7))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  body        String    @default("")
  pinned      Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([projectId])
  @@map("note")
}

/// "When <notification kind> happens, POST a webhook." Runs are queued in the same transaction
/// as the notification (outbox) and delivered by a worker with the SSRF guard.
model Automation {
  id          String          @id @default(uuid(7))
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// A notification kind (notifications/notify.ts).
  trigger     String
  /// Webhook URL (http/https, public address only).
  url         String
  /// generic (DevHub JSON) | slack | discord: body shape the receiver expects.
  format      String          @default("generic")
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  runs        AutomationRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId, trigger])
  @@map("automation")
}

enum AutomationRunStatus {
  pending
  succeeded
  failed
}

model AutomationRun {
  id           String              @id @default(uuid(7))
  automationId String
  automation   Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       AutomationRunStatus @default(pending)
  /// JSON body to send, fixed when the event happened.
  payload      String
  attempts     Int                 @default(0)
  statusCode   Int?
  error        String?
  createdAt    DateTime            @default(now())
  finishedAt   DateTime?

  @@index([status, createdAt])
  @@index([automationId, createdAt])
  @@map("automation_run")
}

/// AI Center prompt library: reusable prompts with {{variables}}.
model Prompt {
  id          String    @id @default(uuid(7))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  body        String
  tags        String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, title])
  @@map("prompt")
}

/// A computer paired as a Local Agent (Phase 5, ADR 0007). Only the hash of its secret is stored.
model Device {
  id           String     @id @default(uuid(7))
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  platform     String
  secretHash   String     @unique
  /// Actions the user allows on this device (Settings).
  capabilities String[]   @default([])
  /// Folders the agent last reported as authorized: [{ path, name }].
  folders      Json       @default("[]")
  pairedById   String
  lastSeenAt   DateTime?
  createdAt    DateTime   @default(now())
  jobs         AgentJob[]

  @@index([workspaceId])
  @@map("device")
}

/// One-time code that lets a desktop app become a Device. Valid 10 minutes.
model DevicePairing {
  id          String    @id @default(uuid(7))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  codeHash    String    @unique
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("device_pairing")
}

enum AgentJobStatus {
  queued
  running
  succeeded
  failed
  expired
}

/// A typed action queued for a device, claimed once by its agent.
model AgentJob {
  id            String         @id @default(uuid(7))
  workspaceId   String
  deviceId      String
  device        Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action        String
  params        Json           @default("{}")
  status        AgentJobStatus @default(queued)
  result        Json?
  error         String?
  requestedById String
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  finishedAt    DateTime?

  @@index([deviceId, status, createdAt])
  @@map("agent_job")
}
