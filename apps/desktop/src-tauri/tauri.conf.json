{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevHub",
  "version": "0.0.0",
  "identifier": "dev.devhub.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../offline"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
